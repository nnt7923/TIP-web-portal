generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum UniversityStatus {
  PENDING
  VERIFIED
  SUSPENDED
  INACTIVE
}

enum GlobalRole {
  USER
  SYSTEM_ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Account {
  id              String        @id @default(uuid())
  username        String        @unique
  email           String        @unique
  passwordHash    String
  fullName        String
  phone           String?
  globalRole      GlobalRole    @default(USER)
  status          AccountStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  deletedAt       DateTime?

  schoolUser SchoolUser?
  auditLogs  AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([globalRole])
  @@index([status])
}

model University {
  id                String             @id @default(uuid())
  name              String
  code              String             @unique
  website           String?
  address           String?
  logoUrl           String?
  logoPublicId      String?
  status            UniversityStatus   @default(PENDING)
  schoolUsers       SchoolUser[]
  majors            Major[]
  academicYears     AcademicYear[]
  internshipPeriods InternshipPeriod[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SchoolUserRole {
  UNIVERSITY_ADMIN
  STAFF
  UNIVERSITY_SUPERVISOR
}

enum SchoolUserStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

model SchoolUser {
  id           String           @id @default(uuid())
  accountId    String           @unique
  universityId String
  role         SchoolUserRole
  status       SchoolUserStatus @default(PENDING)

  account    Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  university University @relation(fields: [universityId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([universityId])
  @@index([universityId, role])
}

model Major {
  id           String  @id @default(uuid())
  universityId String
  name         String
  code         String?

  university University @relation(fields: [universityId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([universityId, name])
  @@unique([universityId, code])
  @@index([universityId])
}

enum AcademicYearStatus {
  ACTIVE
  INACTIVE
}

model AcademicYear {
  id           String             @id @default(uuid())
  universityId String
  name         String
  startDate    DateTime
  endDate      DateTime
  status       AcademicYearStatus @default(ACTIVE)

  university        University         @relation(fields: [universityId], references: [id])
  internshipPeriods InternshipPeriod[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([universityId, name])
  @@index([universityId])
}

enum InternshipPeriodStatus {
  DRAFT
  OPEN
  ONGOING
  COMPLETED
  CANCELLED
}

model InternshipPeriod {
  id             String                 @id @default(uuid())
  universityId   String
  academicYearId String
  name           String
  periodNumber   Int
  startDate      DateTime
  endDate        DateTime
  applyStartDate DateTime?
  applyEndDate   DateTime?
  requiredHours  Int?
  requiredWeeks  Int?
  status         InternshipPeriodStatus @default(DRAFT)

  university   University   @relation(fields: [universityId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYearId, periodNumber])
  @@index([universityId])
  @@index([academicYearId])
}

model AuditLog {
  id         String  @id @default(uuid())
  actorId    String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?

  actor Account @relation(fields: [actorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
