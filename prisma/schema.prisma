generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum UniversityStatus {
  PENDING
  VERIFIED
  SUSPENDED
  INACTIVE
}

enum GlobalRole {
  USER
  SYSTEM_ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Account {
  id              String        @id @default(uuid())
  username        String        @unique
  email           String        @unique
  passwordHash    String
  fullName        String
  phone           String?
  globalRole      GlobalRole    @default(USER)
  status          AccountStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  deletedAt       DateTime?

  schoolUser  SchoolUser?
  student     Student?
  companyUser CompanyUser?
  auditLogs   AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([globalRole])
  @@index([status])
}

model University {
  id                String             @id @default(uuid())
  name              String
  code              String             @unique
  website           String?
  address           String?
  logoUrl           String?
  logoPublicId      String?
  status            UniversityStatus   @default(PENDING)
  schoolUsers       SchoolUser[]
  majors            Major[]
  academicYears     AcademicYear[]
  internshipPeriods InternshipPeriod[]
  students          Student[]
  applications      Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SchoolUserRole {
  UNIVERSITY_ADMIN
  STAFF
  UNIVERSITY_SUPERVISOR
}

enum SchoolUserStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

model SchoolUser {
  id           String           @id @default(uuid())
  accountId    String           @unique
  universityId String
  role         SchoolUserRole
  status       SchoolUserStatus @default(PENDING)

  account    Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  university University @relation(fields: [universityId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([universityId])
  @@index([universityId, role])
}

model Major {
  id           String  @id @default(uuid())
  universityId String
  name         String
  code         String?

  students Student[]

  university University @relation(fields: [universityId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([universityId, name])
  @@unique([universityId, code])
  @@index([universityId])
}

enum AcademicYearStatus {
  ACTIVE
  INACTIVE
}

model AcademicYear {
  id           String             @id @default(uuid())
  universityId String
  name         String
  startDate    DateTime
  endDate      DateTime
  status       AcademicYearStatus @default(ACTIVE)

  university        University         @relation(fields: [universityId], references: [id])
  internshipPeriods InternshipPeriod[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([universityId, name])
  @@index([universityId])
}

enum InternshipPeriodStatus {
  DRAFT
  OPEN
  ONGOING
  COMPLETED
  CANCELLED
}

model InternshipPeriod {
  id                 String                 @id @default(uuid())
  universityId       String
  academicYearId     String
  name               String
  periodNumber       Int
  startDate          DateTime
  endDate            DateTime
  applyStartDate     DateTime?
  applyEndDate       DateTime?
  requiredHours      Int?
  requiredWeeks      Int?
  status             InternshipPeriodStatus @default(DRAFT)
  studentInternships StudentInternship[]

  university   University   @relation(fields: [universityId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYearId, periodNumber])
  @@index([universityId])
  @@index([academicYearId])
}

enum StudentInternshipStatus {
  NOT_ASSIGNED
  READY
  APPLYING
  PLACED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Student {
  id           String @id @default(uuid())
  accountId    String @unique
  universityId String
  majorId      String

  studentCode String
  semester    Int?
  className   String?
  cvUrl       String?
  cvPublicId  String?

  status StudentStatus @default(ACTIVE)

  internships  StudentInternship[]
  applications Application[]

  account    Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  university University @relation(fields: [universityId], references: [id], onDelete: Restrict)
  major      Major      @relation(fields: [majorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Allows Application to reference a student together with their university.
  @@unique([id, universityId])
  @@unique([universityId, studentCode])
  @@index([universityId])
  @@index([majorId])
  @@index([status])
}

model StudentInternship {
  id                 String @id @default(uuid())
  studentId          String
  internshipPeriodId String

  status StudentInternshipStatus @default(READY)

  student          Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  internshipPeriod InternshipPeriod @relation(fields: [internshipPeriodId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, internshipPeriodId])
  @@index([internshipPeriodId])
}

enum CompanyStatus {
  PENDING
  VERIFIED
  SUSPENDED
  INACTIVE
}

model Company {
  id           String        @id @default(uuid())
  name         String
  website      String?
  address      String?
  industry     String?
  logoUrl      String?
  logoPublicId String?
  status       CompanyStatus @default(PENDING)

  companyUsers  CompanyUser[]
  opportunities Opportunity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CompanyUserRole {
  COMPANY_ADMIN
  STAFF
}

enum CompanyUserStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

model CompanyUser {
  id        String            @id @default(uuid())
  accountId String            @unique
  companyId String
  role      CompanyUserRole
  status    CompanyUserStatus @default(PENDING)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, role])
  @@index([status])
}

enum OpportunityType {
  INTERNSHIP //intern 2-4month (normal)
  MICRO_INTERNSHIP // intern follow task, ex: doing this test case module in 10day or in 2weeks
  JOB //normal job, not belong to internship
}

enum OpportunityStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
}

model Opportunity {
  id                  String            @id @default(uuid())
  companyId           String
  title               String
  type                OpportunityType
  description         String
  location            String?
  vacancies           Int?
  applicationDeadline DateTime?
  status              OpportunityStatus @default(DRAFT)

  applications Application[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([type])
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
  WITHDRAWN //studen cancel apply
}

model Application {
  id            String @id @default(uuid())
  universityId  String
  studentId     String
  opportunityId String

  status    ApplicationStatus @default(PENDING)
  appliedAt DateTime          @default(now())

  university  University  @relation(fields: [universityId], references: [id], onDelete: Restrict)
  // The composite foreign key prevents assigning a student's application to another university.
  student     Student     @relation(fields: [studentId, universityId], references: [id, universityId], onDelete: Restrict)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, opportunityId])
  @@index([universityId])
  @@index([studentId])
  @@index([opportunityId])
  @@index([status])
}

model AuditLog {
  id         String  @id @default(uuid())
  actorId    String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?

  actor Account @relation(fields: [actorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
